  "html": "\n<style>\n    @page { size: A4 landscape; margin: 10mm 8mm; }\n\n    .pi-print {\n        color: #1f2933;\n        font-family: Arial, sans-serif;\n        font-size: 9.5px;\n        line-height: 1.35;\n    }\n    .pi-header {\n        border-bottom: 2px solid #1f4e79;\n        margin-bottom: 10px;\n        padding-bottom: 8px;\n    }\n    .pi-title-row {\n        display: table;\n        width: 100%;\n    }\n    .pi-title-cell {\n        display: table-cell;\n        vertical-align: top;\n    }\n    .pi-title {\n        color: #123b5d;\n        font-size: 19px;\n        font-weight: 700;\n        margin: 0;\n        text-transform: uppercase;\n    }\n    .pi-subtitle {\n        color: #66788a;\n        font-size: 10px;\n        margin-top: 3px;\n    }\n    .pi-docbox {\n        border: 1px solid #d8e1ea;\n        border-radius: 4px;\n        display: inline-block;\n        float: right;\n        padding: 7px 10px;\n        min-width: 210px;\n        background: #f7fafc;\n    }\n    .pi-docbox .label {\n        color: #66788a;\n        font-size: 8px;\n        text-transform: uppercase;\n    }\n    .pi-docbox .value {\n        color: #123b5d;\n        font-size: 13px;\n        font-weight: 700;\n    }\n    .pi-meta, .pi-summary, .pi-approval {\n        width: 100%;\n        border-collapse: collapse;\n        margin: 8px 0;\n    }\n    .pi-meta td {\n        border: 1px solid #e3e8ef;\n        padding: 6px 8px;\n        width: 25%;\n    }\n    .pi-label {\n        color: #66788a;\n        display: block;\n        font-size: 8px;\n        letter-spacing: .2px;\n        text-transform: uppercase;\n    }\n    .pi-value {\n        color: #1f2933;\n        font-weight: 600;\n    }\n    .pi-summary td {\n        border: 1px solid #d8e1ea;\n        padding: 7px 9px;\n        width: 25%;\n        background: #f7fafc;\n    }\n    .pi-summary .amount {\n        color: #123b5d;\n        font-size: 14px;\n        font-weight: 700;\n    }\n    .pi-section-title {\n        color: #123b5d;\n        font-size: 11px;\n        font-weight: 700;\n        margin: 11px 0 5px;\n        text-transform: uppercase;\n    }\n    .pi-items {\n        width: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n    }\n    .pi-items th {\n        background: #1f4e79;\n        border: 1px solid #1b4266;\n        color: #fff;\n        font-size: 8px;\n        font-weight: 700;\n        padding: 5px 4px;\n        text-transform: uppercase;\n        vertical-align: middle;\n    }\n    .pi-items td {\n        border: 1px solid #d8e1ea;\n        padding: 5px 4px;\n        vertical-align: top;\n        word-wrap: break-word;\n    }\n    .pi-items tbody tr:nth-child(even) td {\n        background: #f9fbfd;\n    }\n    .pi-right { text-align: right; }\n    .pi-center { text-align: center; }\n    .pi-muted { color: #66788a; }\n    .pi-small { font-size: 8px; }\n    .pi-status {\n        border-radius: 3px;\n        display: inline-block;\n        font-size: 8px;\n        font-weight: 700;\n        padding: 2px 5px;\n        text-transform: uppercase;\n        background: #eef2f6;\n        color: #334e68;\n    }\n    .pi-status-approved { background: #e3f8e8; color: #207544; }\n    .pi-status-partially-approved { background: #fff4d6; color: #8a5a00; }\n    .pi-status-rejected { background: #fde8e8; color: #a61b1b; }\n    .pi-status-hold { background: #edf2ff; color: #284b8f; }\n    .pi-approval td {\n        border: 1px solid #e3e8ef;\n        padding: 7px 8px;\n    }\n    .pi-declaration {\n        border-left: 3px solid #1f4e79;\n        color: #465a69;\n        margin-top: 10px;\n        padding: 6px 8px;\n        background: #f7fafc;\n    }\n</style>\n\n<div class=\"pi-print\">\n    {% set company = doc.items[0].company if doc.items else \"\" %}\n    {% if company %}\n        {% set letter_head = frappe.db.get_value(\"Company\", company, \"default_letter_head\") %}\n        {% if letter_head %}{{ frappe.render_template(frappe.db.get_value(\"Letter Head\", letter_head, \"content\") or \"\", {\"doc\": doc}) }}{% endif %}\n    {% endif %}\n\n    <div class=\"pi-header\">\n        <div class=\"pi-title-row\">\n            <div class=\"pi-title-cell\">\n                <h1 class=\"pi-title\">Payment Indent Approval Report</h1>\n                <div class=\"pi-subtitle\">Manager-level approval record. Accounting verification and payment processing are separate steps.</div>\n            </div>\n            <div class=\"pi-title-cell\">\n                <div class=\"pi-docbox\">\n                    <span class=\"pi-label\">Payment Indent</span>\n                    <div class=\"value\">{{ doc.name }}</div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <table class=\"pi-meta\">\n        <tr>\n            <td><span class=\"pi-label\">Posting Date</span><span class=\"pi-value\">{{ frappe.format(doc.posting_date, {\"fieldtype\": \"Date\"}) }}</span></td>\n            <td><span class=\"pi-label\">Requested By</span><span class=\"pi-value\">{{ frappe.db.get_value(\"User\", doc.requested_by, \"full_name\") or doc.requested_by }}</span></td>\n            <td><span class=\"pi-label\">Workflow State</span><span class=\"pi-value\">{{ doc.workflow_state or \"\" }}</span></td>\n            <td><span class=\"pi-label\">Priority</span><span class=\"pi-value\">{{ doc.priority or \"\" }}</span></td>\n        </tr>\n    </table>\n\n    <table class=\"pi-summary\">\n        <tr>\n            <td><span class=\"pi-label\">Total Requested</span><span class=\"amount\">{{ frappe.format(doc.total_requested_amount, {\"fieldtype\": \"Currency\"}) }}</span></td>\n            <td><span class=\"pi-label\">Total Approved</span><span class=\"amount\">{{ frappe.format(doc.total_approved_amount, {\"fieldtype\": \"Currency\"}) }}</span></td>\n            <td><span class=\"pi-label\">Approved By</span><span class=\"pi-value\">{{ frappe.db.get_value(\"User\", doc.manager_approved_by, \"full_name\") or doc.manager_approved_by or \"\" }}</span></td>\n            <td><span class=\"pi-label\">Approved On</span><span class=\"pi-value\">{{ frappe.format(doc.manager_approved_on, {\"fieldtype\": \"Datetime\"}) if doc.manager_approved_on else \"\" }}</span></td>\n        </tr>\n    </table>\n\n    <div class=\"pi-section-title\">Payment Lines</div>\n    <table class=\"pi-items\">\n        <thead>\n            <tr>\n                <th style=\"width:3%;\">Sr</th>\n                <th style=\"width:13%;\">Party</th>\n                <th style=\"width:12%;\">Company</th>\n                <th style=\"width:9%;\">Ref Type</th>\n                <th style=\"width:10%;\">Reference</th>\n                <th style=\"width:9%;\">Terms</th>\n                <th style=\"width:9%;\">Remark</th>\n                <th style=\"width:8%;\" class=\"pi-right\">Party Balance</th>\n                <th style=\"width:6%;\">Balance</th>\n                <th style=\"width:7%;\" class=\"pi-right\">Requested</th>\n                <th style=\"width:7%;\" class=\"pi-right\">Approved</th>\n                <th style=\"width:7%;\">Status</th>\n            </tr>\n        </thead>\n        <tbody>\n        {% for row in doc.items %}\n            {% set reference_number = row.reference_name or row.purchase_invoice or row.purchase_order or row.work_order_reference or \"No Reference\" %}\n            {% set payment_terms = row.payment_terms_other if row.payment_terms == \"Others\" and row.payment_terms_other else row.payment_terms %}\n            {% set status_class = (row.row_status or \"Pending\").lower().replace(\" \", \"-\") %}\n            <tr>\n                <td class=\"pi-center\">{{ loop.index }}</td>\n                <td><strong>{{ row.party_search or row.party_name or row.party or \"\" }}</strong></td>\n                <td>{{ row.company }}</td>\n                <td>{{ row.reference_type }}</td>\n                <td>{{ reference_number }}</td>\n                <td>{{ payment_terms or \"\" }}</td>\n                <td>{{ row.payment_remark or \"\" }}</td>\n                <td class=\"pi-right\">{{ frappe.format(row.party_balance, {\"fieldtype\": \"Currency\"}) }}</td>\n                <td>{{ row.balance_type or \"\" }}</td>\n                <td class=\"pi-right\">{{ frappe.format(row.requested_amount, {\"fieldtype\": \"Currency\"}) }}</td>\n                <td class=\"pi-right\"><strong>{{ frappe.format(row.approved_amount, {\"fieldtype\": \"Currency\"}) }}</strong></td>\n                <td><span class=\"pi-status pi-status-{{ status_class }}\">{{ row.row_status or \"\" }}</span></td>\n            </tr>\n            {% if row.manager_remarks %}\n            <tr>\n                <td></td>\n                <td colspan=\"11\"><span class=\"pi-label\">Manager Remarks</span>{{ row.manager_remarks }}</td>\n            </tr>\n            {% endif %}\n        {% endfor %}\n        </tbody>\n    </table>\n\n    <div class=\"pi-section-title\">Approval</div>\n    <table class=\"pi-approval\">\n        <tr>\n            <td style=\"width: 33%;\"><span class=\"pi-label\">Approved By</span><span class=\"pi-value\">{{ frappe.db.get_value(\"User\", doc.manager_approved_by, \"full_name\") or doc.manager_approved_by or \"\" }}</span></td>\n            <td style=\"width: 33%;\"><span class=\"pi-label\">Approved On</span><span class=\"pi-value\">{{ frappe.format(doc.manager_approved_on, {\"fieldtype\": \"Datetime\"}) if doc.manager_approved_on else \"\" }}</span></td>\n            <td style=\"width: 34%;\"><span class=\"pi-label\">Workflow State</span><span class=\"pi-value\">{{ doc.workflow_state or \"\" }}</span></td>\n        </tr>\n        <tr>\n            <td colspan=\"3\"><span class=\"pi-label\">Manager Remarks</span>{{ doc.manager_remarks or \"\" }}</td>\n        </tr>\n    </table>\n\n    <div class=\"pi-declaration\"><strong>Declaration:</strong> {{ doc.declaration_note or \"This report confirms manager-level approval only. Accounting verification and payment processing shall be completed separately as per the institution's payment procedure.\" }}</div>\n</div>\n",
